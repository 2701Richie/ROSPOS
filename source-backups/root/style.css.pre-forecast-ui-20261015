:root{--bg:#F2F5F4;--sf:#fff;--ink:#14211D;--mu:#51615B;--bd:#C5D0CB;--ac:#0F5C4D;--ai:#fff;--wb:#FFF1D6;--wt:#7A4A00;--bb:#FDE4E1;--bt:#8A1C12;color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media(prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0E1513;--sf:#17211E;--ink:#E6EEEA;--mu:#9DB0A8;--bd:#2E3D38;--ac:#3FB89C;--ai:#06201A;--wb:#3A2C0A;--wt:#F5C97A;--bb:#3E1713;--bt:#F5A79F;color-scheme:dark}}
:root[data-theme="dark"]{--bg:#0E1513;--sf:#17211E;--ink:#E6EEEA;--mu:#9DB0A8;--bd:#2E3D38;--ac:#3FB89C;--ai:#06201A;--wb:#3A2C0A;--wt:#F5C97A;--bb:#3E1713;--bt:#F5A79F;color-scheme:dark}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*{box-sizing:border-box}
[hidden]{display:none!important}
body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.4 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}
header{display:flex;flex-wrap:wrap;gap:12px;align-items:center;justify-content:space-between;padding:12px 20px;background:var(--ac);color:var(--ai)}
header b{font-size:19px}
nav{display:flex;gap:8px}
button{font:inherit;cursor:pointer;min-height:44px;padding:0 16px;border-radius:10px;border:1px solid var(--bd);background:var(--sf);color:var(--ink)}
nav button{background:transparent;color:var(--ai);border-color:transparent;font-weight:600}
nav button.on{background:var(--ai);color:var(--ac)}
button.pri{background:var(--ac);color:var(--ai);border-color:var(--ac);font-weight:700}
button.big{width:100%;min-height:60px;font-size:19px;margin-top:12px}
main{padding:16px 20px;max-width:1280px;margin:0 auto}
.two{display:grid;grid-template-columns:1fr 380px;gap:16px;align-items:start}
@media(max-width:900px){.two{grid-template-columns:1fr}}
.card{background:var(--sf);border:1px solid var(--bd);border-radius:12px;padding:16px}
input,select,textarea{font:inherit;min-height:48px;padding:8px 12px;border:1px solid var(--bd);border-radius:10px;background:var(--sf);color:var(--ink);width:100%}
#grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(170px,1fr));gap:12px;margin-top:12px}
.tile{text-align:left;min-height:104px;display:flex;flex-direction:column;justify-content:space-between;padding:12px}
.mu,small{color:var(--mu)}
.tag{font-size:12px;font-weight:600;padding:2px 8px;border-radius:6px;display:inline-block}
.w{background:var(--wb);color:var(--wt)}.b{background:var(--bb);color:var(--bt)}
.row{display:flex;align-items:center;gap:8px;padding:10px 0;border-bottom:1px solid var(--bd)}
.row .g{flex:1;min-width:0}
.q{width:44px;padding:0;font-size:20px}
.seg{display:flex;gap:8px;margin:12px 0}.seg button{flex:1;padding:0 6px}
.seg .on{background:var(--ac);color:var(--ai);border-color:var(--ac)}
.tr{display:flex;justify-content:space-between;margin:4px 0}.tr.t{font-size:22px;font-weight:700}
.wrap{overflow-x:auto}
table{width:100%;border-collapse:collapse}th,td{text-align:left;padding:8px;border-bottom:1px solid var(--bd);font-size:14px}
.form{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px;margin-bottom:12px}
label{display:block;font-size:13px;color:var(--mu)}label input{margin-top:4px}
.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:12px;margin-bottom:16px}.stats b{font-size:24px;display:block}
.stats ul{margin:8px 0 0;padding-left:18px;font-size:14px}
.acts{display:flex;gap:8px;margin:12px 0}
.err{min-height:22px;font-size:14px;color:var(--bt);margin-top:8px}
h2,h3{margin:0 0 8px}
#md{position:fixed;inset:0;background:rgba(0,0,0,.55);display:flex;align-items:center;justify-content:center;padding:16px}
#rc{background:#fff;color:#000;width:320px;max-height:90vh;overflow:auto;padding:16px;font:13px/1.5 ui-monospace,monospace;border-radius:8px}
#rc button{color:#000;background:#eee;border-color:#999}#rc button.pri{background:#0F5C4D;color:#fff}
#pm{position:fixed;inset:0;background:rgba(0,0,0,.55);display:flex;align-items:center;justify-content:center;padding:16px}#pb{width:min(440px,100%);max-height:92vh;overflow:auto}
@media print{body>*:not(#md){display:none!important}#md{position:static;background:none;display:block;padding:0}.np{display:none!important}#rc{width:100%;max-height:none}}
#op{display:none}
@media print{body.po #op{display:block!important;color:#000;background:#fff}body.po{background:#fff}}
.ov{position:fixed;inset:0;z-index:60;background:var(--bg);display:flex;align-items:center;justify-content:center;padding:16px}.ov .card{width:min(400px,100%)}
#who{font-size:14px}
